{
  "name": "qsmbly",
  "version": "0.23.1",
  "description": "Quantitative Susceptibility Mapping in WebAssembly",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "vendor": "node ../../scripts/vendor-components.mjs --dest .",
    "predev": "pnpm vendor",
    "prebuild": "pnpm vendor && bash build.sh",
    "build": "node ../../scripts/build-static.mjs",
    "lint": "node ../../scripts/check-app-js.mjs .",
    "pretest": "pnpm vendor",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12"
  },
  "dependencies": {
    "@neurodesk/webapp-components": "workspace:*"
  },
  "neurodeskWebapp": {
    "static": {
      "include": [
        "index.html",
        "css",
        "js",
        "vendor",
        "dcm2niix",
        "nifti-js",
        "niivue",
        "wasm",
        "QSMbly.png",
        "icon.svg",
        "favicon.ico"
      ]
    }
  },
  "private": true,
  "keywords": [
    "qsm",
    "mri",
    "webassembly",
    "wasm",
    "medical-imaging"
  ],
  "license": "MIT"
}
