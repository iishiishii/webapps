{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeneratedFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["filename", "content"],
  "properties": {
    "filename": { "type": "string", "description": "Must exactly equal the requested target filename; the runtime schema specializes this with const." },
    "content": { "type": "string", "minLength": 1 }
  }
}
